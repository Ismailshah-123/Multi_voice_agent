# Database — use real PostgreSQL, not SQLite (models use native Postgres UUID columns)
DATABASE_URL=postgresql://user:password@localhost:5432/voiceagent

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change_this_to_a_long_random_secret

# Voice Engine
VAPI_API_KEY=your_vapi_key
VAPI_ORG_ID=your_vapi_org_id

# AI Providers
GROQ_API_KEY=your_groq_key
# No longer needed for RAG - embeddings run locally and free now (sentence-transformers)
OPENAI_API_KEY=

# Telephony fallback
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# Google (Gmail + Calendar)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Microsoft (Outlook + Calendar)
MICROSOFT_CLIENT_ID=your_ms_client_id
MICROSOFT_CLIENT_SECRET=your_ms_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/microsoft/callback

# WhatsApp Business
WHATSAPP_TOKEN=your_whatsapp_business_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Billing
STRIPE_SECRET_KEY=your_stripe_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Vector DB (RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# CORS — comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
